# 复制本文件为 .env 后填写真实值；.env 已进 .gitignore，绝不提交

# ---- LLM：通义千问 DashScope（https://bailian.console.aliyun.com 申请）----
DASHSCOPE_API_KEY=sk-你的密钥
LLM_MODEL=qwen-plus
# OpenAI 兼容模式入口，固定值
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ---- 分块参数（调参只改这里，不改代码）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---- 检索 ----
TOP_K=5
