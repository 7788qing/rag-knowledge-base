# 复制本文件为 .env 后填写真实值；.env 已进 .gitignore，绝不提交

# ---- 对话模型：DeepSeek（https://platform.deepseek.com/api_keys 申请）----
LLM_API_KEY=sk-你的DeepSeek密钥
LLM_BASE_URL=https://api.deepseek.com/v1
# 如果报「模型不存在」，把下面一行改成 deepseek-chat 或 deepseek-v4-pro
LLM_MODEL=deepseek-flash

# ---- 向量模型：硅基流动 SiliconFlow（https://cloud.siliconflow.cn 注册，bge-m3 免费）----
# DeepSeek 没有 embedding 接口，所以向量化单独用这一家
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_API_KEY=sk-你的硅基流动密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 分块参数（调参只改这里，不改代码）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---- 检索 ----
TOP_K=5
